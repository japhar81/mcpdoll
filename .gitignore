# Build output
/bin/
/dist/
*.wasm.gz

# Go
*.test
*.out
coverage.txt
coverage.html

# Node / web
node_modules/
web/dist/
.vite/
playwright-report/
test-results/
blob-report/

# Local environment
.env
.env.local
*.local.yaml

# Signing keys — never commit private material. `make dev` generates a
# throwaway keypair under deploy/local/.
deploy/local/*.key
deploy/local/*.pem

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local dev artifacts generated by `make dev`. The registry document and the
# data-plane config ARE committed; the keypair, the built snapshot, and the logs
# are per-machine.
deploy/local/*.pub
deploy/local/snapshot.pb
deploy/local/revocations.pb
deploy/local/principals.pb
# Minted agent credentials. `make dev` writes real, working secrets here, and
# the `mcpd.` marker exists precisely so a scanner flags them in a repository —
# so committing this file would trip the alarm this project designed.
deploy/local/demo-keys.txt
deploy/local/logs/
deploy/local/dev.pids
deploy/local/plugins/*.wasm
