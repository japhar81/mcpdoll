      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "p99 hook latency",
      "description": "Time in one hook, all its plugins included. This is what the pipeline adds to a request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, mcpdoll_hook) (rate(mcpdoll_hook_latency_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{mcpdoll_hook}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {}
        },
        "overrides": []
      },
