          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Budget exhaustion and plugin skips",
      "description": "A skipped plugin is a control that did not run. Budget exhaustion is recorded rather than failing the request \u2014 see ADR 0007.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mcpdoll_pipeline_budget_exhausted_total[$__rate_interval]))",
          "legendFormat": "budget exhausted",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mcpdoll_plugin) (rate(mcpdoll_plugin_skips_total[$__rate_interval]))",
          "legendFormat": "skipped: {{mcpdoll_plugin}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
