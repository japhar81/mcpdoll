# The console, running Vite's dev server.
#
# The dev server rather than a static build on purpose: this stack exists to be
# worked in, and a source edit should be visible on refresh rather than after an
# image rebuild. A production image would `npm run build` and serve the output.

FROM node:22-alpine

WORKDIR /app

# Manifests first so `npm ci` is cached against dependency changes rather than
# every source edit.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app \
 && chown -R app:app /app
USER app

EXPOSE 5173
# --host binds 0.0.0.0. Vite defaults to localhost, which inside a container
# means the port is published and nothing answers on it.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
